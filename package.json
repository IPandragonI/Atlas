{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && node scripts/build-worker.mjs && npm run data:daily && next build && node scripts/build-sw.mjs",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:build": "tsx scripts/build-data.ts",
    "data:daily": "tsx scripts/generate-daily.ts",
    "data:simulate": "tsx scripts/simulate.ts",
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/build-worker.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "data:audit-sea": "tsx scripts/audit-sea.ts",
    "data:revalidate-daily": "tsx scripts/revalidate-daily.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "flag-icons": "^7.6.0",
